# Copier ce fichier en .env et remplir les vraies valeurs — .env n'est
# jamais envoyé sur GitHub (il est dans .gitignore).

# Neon > Connect > Connection string. Deux adresses pour la même base :
# celle avec « Connection pooling » coché (hôte en -pooler) pour les requêtes
# de l'application, celle sans pooling pour les migrations Prisma.
DATABASE_URL="postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Clé Google AI Studio (Gemini) — appréciations de bulletin automatiques.
GEMINI_API_KEY=""
