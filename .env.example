# Copier ce fichier en .env et remplir les vraies valeurs — .env n'est
# jamais envoyé sur GitHub (il est dans .gitignore).

# Supabase > Connect > ORMs > Prisma. Deux URLs : le pooler en mode
# transaction (port 6543) pour les requêtes de l'application, le pooler en
# mode session (port 5432) pour les migrations.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Connexion Google, gérée par Supabase Auth (Authentication > Providers >
# Google dans le tableau de bord Supabase) — bouton "Continuer avec Google"
# sur la page d'inscription. La clé anon/publishable est publique par design.
# Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé Google AI Studio (Gemini) — appréciations de bulletin automatiques.
GEMINI_API_KEY=""
